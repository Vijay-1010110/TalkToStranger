# TalkToStranger Production Environment Configuration
PORT=5000

# Optional: Strong JWT Secret (automatically generates a cryptographically secure random 256-bit key if omitted)
# JWT_SECRET=your-256-bit-secret-key-here

# WebRTC Metered TURN Relay Configuration (for cross-VPN and 4G/5G mobile traversal)
# Method 1: Direct TURN credentials (Recommended)
TURN_USERNAME=your-metered-turn-username
TURN_CREDENTIAL=your-metered-turn-password

# Method 2: Dynamic Metered API Key
# METERED_APP_NAME=your-metered-subdomain
# METERED_API_KEY=your-metered-api-key

# Optional: Custom self-hosted Coturn / TURN URLs (comma-separated)
# TURN_URLS=turn:your-domain.com:3478

# Security: Allowed CORS origins (comma-separated)
# ALLOWED_ORIGINS=https://talktostranger-9my8.onrender.com,https://vijay-1010110.github.io
