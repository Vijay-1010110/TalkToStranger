# Port for local development
PORT=5000

# ========================================================
# WEBRTC TURN RELAY CONFIGURATION
# (Required for VPNs, 4G/5G mobile carriers, and strict NATs)
# ========================================================
# OPTION 1: Metered.ca Free TURN (Recommended - 50GB Free/month)
# 1. Sign up for free at https://dashboard.metered.ca (No credit card needed)
# 2. Copy your App Name and API Key from "TURN Server" -> "Credentials"
METERED_APP_NAME=
METERED_API_KEY=

# OPTION 2: Custom Coturn / Static TURN Relay Server
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:443?transport=tcp
# TURN_USERNAME=your_turn_username
# TURN_CREDENTIAL=your_turn_password

# Authentication Secret
JWT_SECRET=supersecret_jwt_key_stranger_chat_2026
